# MySQL Database Configuration (OneAPI)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=oneapi

# PostgreSQL Database Configuration (NewAPI)
NEWAPI_DB_HOST=localhost
NEWAPI_DB_PORT=5432
NEWAPI_DB_USER=your_pg_user
NEWAPI_DB_PASSWORD=your_pg_password
NEWAPI_DB_NAME=new_api

# Feishu Notification
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-token
FEISHU_ALERT_THRESHOLD=100
FEISHU_RETRY_MAX_ATTEMPTS=4
FEISHU_RETRY_DELAY_MS=30000
FEISHU_USER_MAPPING={"张三":"ou_xxx","李四":"ou_yyy"}

# Feishu Open Platform (for Bitable write)
# 用于把每日超额同事信息自动写入飞书多维表格（使用情况说明列留空，由人工填写）
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_BITABLE_APP_TOKEN=app_xxx
FEISHU_BITABLE_TABLE_ID=tbl_xxx
FEISHU_BITABLE_DATE_FIELD=时间
FEISHU_BITABLE_PERSON_FIELD=人员
FEISHU_BITABLE_COST_FIELD=今日消耗
# 多维表格完整地址（用于私信里的「前往填写」按钮，不填则按 app_token+table_id 拼接）
FEISHU_BITABLE_URL=https://your-domain.feishu.cn/base/app_xxx?table=tbl_xxx

# 超额同事私信提醒：设为 1 时，每日报表会给当天超额且有 open_id 映射的同事
# 单独发飞书卡片私信，提示去多维表格补充说明。默认关闭，避免误打扰。
FEISHU_NOTIFY_OVERAGE_DM=0

# Server Port
PORT=3001
